{
  "schema_version": 1,
  "repository": {
    "name": "ai-skill-hub",
    "source_policy": "single-source-of-truth",
    "source_directory": "~/.agents/skills",
    "distribution": "copy",
    "management_scope": "global"
  },
  "targets": [
    {
      "id": "agents",
      "path": "~/.agents/skills",
      "adapter": "agents-skill",
      "enabled": true
    },
    {
      "id": "opencode",
      "path": "~/.config/opencode/skills",
      "adapter": "agents-skill",
      "enabled": true
    }
  ],
  "skills": [
